{
  "schema": "clotho.sharable/1",
  "id": "text.measure",
  "type": "function",
  "description": "Measure text without drawing it, and say whether it fits a box you name.",
  "phrases": [
    "how wide is this text",
    "will this label fit in the box",
    "text metrics without rendering",
    "how many lines will this caption wrap to",
    "measure a string in a font at a size"
  ],
  "tags": [
    "text",
    "metrics",
    "typography",
    "fit",
    "label",
    "font"
  ],
  "noun": "text",
  "verb": "measure",
  "entry": "lineart-scene textbox",
  "produces": "scene.measurement",
  "requires": [
    {
      "path": "lineart_trace/scene/fonts.py",
      "note": "the font tables this reads"
    },
    {
      "path": "lineart_trace/scene/text.py",
      "note": "the fitting"
    }
  ],
  "returns": "the metrics on stdout; with --width and --height, the lines it would take",
  "examples": [
    {
      "input": [
        "Polymerase",
        "--family",
        "Helvetica",
        "--size",
        "9"
