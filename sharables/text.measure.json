      "output": "{\n  \"format\": \"lineart.measurement/1\",\n  \"unit\": \"pt\",\n  \"frame\": \"page\",\n  \"measure\": \"text\",\n  \"target\": \"Polymerase\",\n  \"value\": {\n    \"advance\": 47.518066,\n    \"ascent\": 6.75,\n    \"cap_height\": 6.455566,\n    \"descent\": 1.529297,\n    \"ink\": {\n      \"x0\": 0.769043,\n      \"x1\": 47.126953,\n      \"y0\": -1.929199,\n      \"y1\": 6.455566\n    },\n    \"line_height\": 8.547363,\n    \"x_height\": 4.706543\n  },\n  \"font\": {\n    \"sha256\": \"25eceb458d4baf628ee0b6a135a9f8ac5ec7b2826646720834bd2bf00dfc825a\",\n    \"family\": \"Helvetica\",\n    \"index\": 0,\n    \"path\": \"/System/Library/Fonts/Helvetica.ttc\",\n    \"subfamily\": \"Regular\",\n    \"units_per_em\": 2048\n  },\n  \"kerning\": false\n}"
    }
  ],
