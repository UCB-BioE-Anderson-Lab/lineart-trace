{
  "format": "lineart.guide/1",
  "name": "figure-default",
  "title": "Figure default",
  "description": "A neutral guide for scientific figures on a white page: one ink, one accent, a five-step stroke scale and a four-step type scale. The series colours were generated by `lineart-scene palette` AGAINST the guide's own ink, accent, support and muted -- a series chosen only against itself clashes with the line work it sits beside, which is how the first version of this guide shipped two colours that are one colour under protanopia.",
  "tokens": {
    "colour": {
      "ink": "#111111",
      "muted": "#6b7280",
      "paper": "#ffffff",
      "surface": "#eef2f7",
      "accent": "#c2452c",
      "support": "#1f3f6b",
      "series-1": "#2b8cee",
      "series-2": "#a37bf4",
      "series-3": "#cb4d8c",
      "series-4": "#962c3d",
      "series-5": "#0f45b3"
    },
    "stroke": {
      "hairline": "0.3pt",
      "fine": "0.4pt",
      "regular": "0.6pt",
      "heavy": "1pt",
      "emphasis": "1.4pt"
    },
    "dash": {
      "guide": [
        "1.5pt",
        "1.5pt"
      ],
      "lead": [
        "3pt",
        "1.5pt"
      ]
    },
    "type": {
      "micro": "5pt",
      "caption": "6pt",
      "label": "8pt",
      "title": "10pt"
    },
    "family": {
      "sans": "Helvetica",
      "mono": "Courier New"
    },
    "space": {
      "gutter": "4mm",
      "margin": "2mm",
      "leader": "1.5mm"
    }
  },
  "roles": {
    "structure-stroke": {
      "stroke": "@colour.ink",
      "fill": "none",
      "stroke_width": "@stroke.regular",
      "stroke_cap": "round",
      "stroke_join": "round"
    },
    "emphasis-stroke": {
      "stroke": "@colour.ink",
      "fill": "none",
      "stroke_width": "@stroke.emphasis",
      "stroke_cap": "round",
      "stroke_join": "round"
    },
    "detail-stroke": {
      "stroke": "@colour.support",
      "fill": "none",
      "stroke_width": "@stroke.fine",
      "stroke_cap": "round"
    },
    "accent-stroke": {
      "stroke": "@colour.accent",
      "fill": "none",
      "stroke_width": "@stroke.heavy",
      "stroke_cap": "round"
    },
    "accent-fill": {
      "fill": "@colour.accent",
      "stroke": "none"
    },
    "surface-fill": {
      "fill": "@colour.surface",
      "stroke": "@colour.support",
      "stroke_width": "@stroke.fine"
    },
    "guide-line": {
      "stroke": "@colour.muted",
      "fill": "none",
      "stroke_width": "@stroke.hairline",
      "stroke_dash": "@dash.guide"
    },
    "caption": {
      "fill": "@colour.ink",
      "stroke": "none",
      "font_family": "@family.sans",
      "font_size": "@type.caption"
    },
    "label": {
      "fill": "@colour.ink",
      "stroke": "none",
      "font_family": "@family.sans",
      "font_size": "@type.label"
    },
    "panel-letter": {
      "fill": "@colour.ink",
      "stroke": "none",
      "font_family": "@family.sans",
      "font_size": "@type.title",
      "font_weight": "bold"
    },
    "series-1": {
      "fill": "@colour.series-1",
      "stroke": "none"
    },
    "series-2": {
      "fill": "@colour.series-2",
      "stroke": "none"
    },
    "series-3": {
      "fill": "@colour.series-3",
      "stroke": "none"
    },
    "series-4": {
      "fill": "@colour.series-4",
      "stroke": "none"
    },
    "series-5": {
      "fill": "@colour.series-5",
      "stroke": "none"
    },
    "paper-fill": {
      "fill": "@colour.paper",
      "stroke": "none"
    }
  },
  "variants": {
    "dark": {
      "title": "Figure default, dark -- with its own series, because a palette is relative to the background it sits on",
      "canvas_background": "#14171c",
      "tokens": {
        "colour": {
          "ink": "#f2f4f7",
          "muted": "#9aa3ae",
          "paper": "#14171c",
          "surface": "#232a33",
          "accent": "#ff7a5c",
          "support": "#8fb6e8",
          "series-1": "#0fb30f",
          "series-2": "#df909d",
          "series-3": "#0fb37c",
          "series-4": "#96612c",
          "series-5": "#2beeee"
        }
      }
    },
    "print": {
      "title": "Figure default, print",
      "canvas_background": "#ffffff",
      "tokens": {
        "stroke": {
          "hairline": "0.4pt",
          "fine": "0.5pt"
        },
        "type": {
          "micro": "6pt",
          "caption": "7pt"
        }
      }
    }
  }
}
